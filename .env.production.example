# ---------------------------------------------------------------------------
# TradeOS — PRODUCTION environment template
# Copy these into your Vercel project's Environment Variables (Production).
# Do NOT commit real secrets. Local dev keeps using .env (SQLite) — see
# .env.example. The Vercel build flips the Prisma provider to Postgres for you.
# ---------------------------------------------------------------------------

# ===========================================================================
# REQUIRED — the app will not run in production without these.
# ===========================================================================

# --- Database (Supabase / Postgres) ----------------------------------------
# Use the Supabase POOLER connection string (Transaction mode, port 6543) for
# the running app — serverless functions need pooled connections.
# Get it in Supabase: Project Settings -> Database -> Connection string.
# Append ?pgbouncer=true&connection_limit=1 for the pooler.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# NOTE: `prisma db push` / migrations need the DIRECT (non-pooled) URL,
# port 5432. The Vercel build runs `db push` against DATABASE_URL, which works
# with the pooler, but if you hit connection errors during schema push, set
# DATABASE_URL to the direct URL for the first deploy, then switch to the pooler:
#   postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# --- Auth ------------------------------------------------------------------
# Signs session JWTs. Generate a fresh one:  openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_openssl_rand_base64_32"

# --- Broker-key encryption -------------------------------------------------
# OPTIONAL dedicated key for encrypting users' stored broker API keys
# (AES-256-GCM). If unset, the encryption key is derived from AUTH_SECRET.
# Recommended: set it on the FIRST deploy so login-signing and at-rest
# encryption rotate independently. WARNING: changing (or first setting) it
# AFTER users have connected brokers invalidates their stored keys — they will
# have to reconnect. Generate:  openssl rand -base64 32
# ENCRYPTION_SECRET="REPLACE_WITH_openssl_rand_base64_32"

# --- Public app URL --------------------------------------------------------
# Your deployed origin (no trailing slash). Used for links and the return
# address people come back to after paying.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --- Scheduled auto-sync (broker connectors) --------------------------------
# On PERSISTENT servers (Railway, VPS, Docker) auto-sync runs in-process — no
# cron needed. Interval in minutes (default 30 in production; 0 disables):
AUTO_SYNC_INTERVAL_MIN="30"

# VERCEL ONLY: protects GET /api/cron/sync for Vercel Cron (which sends this as
# a Bearer token automatically). Not needed on Railway — the in-process
# scheduler is used there instead. Generate:  openssl rand -base64 24
# CRON_SECRET="REPLACE_WITH_openssl_rand_base64_24"


# ===========================================================================
# PADDLE — required to enable paid checkout. Until these are set, the app runs
# with feature gating enforced but checkout shows a "not switched on" notice.
# You can deploy and launch with billing dormant and add these later.
# Start in the SANDBOX, then swap in live values when Paddle approves the
# account. Full step-by-step: GO-LIVE.md.
# ===========================================================================
# "sandbox" or "production". ANY other value (or unset) reads as sandbox, which
# is the safe direction — a sandbox key cannot charge anybody.
PADDLE_ENV="sandbox"
# Server-side API key: Paddle > Developer tools > Authentication > API keys.
PADDLE_API_KEY="pdl_sdbx_apikey_..."
# Secret key of the notification destination you create in Paddle, pointed at
# https://<your-domain>/api/billing/webhook
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
# Price IDs (pri_..., NOT product prd_... ids). Server-only — never sent to the
# browser, because checkout links are minted on the server.
PADDLE_PRICE_ID_PRO="pri_..."     # Pro   — $29/mo
PADDLE_PRICE_ID_ELITE="pri_..."   # Elite — $79/mo
# OPTIONAL — pay-for-a-year prices, on the SAME two products. Leave them out and
# the yearly option never appears; the monthly plans carry on exactly as before.
# PADDLE_PRICE_ID_PRO_ANNUAL="pri_..."     # Pro   — $290/yr (two months free)
# PADDLE_PRICE_ID_ELITE_ANNUAL="pri_..."   # Elite — $790/yr (two months free)


# ===========================================================================
# OPTIONAL — leave unset for a first launch. Features degrade gracefully.
# ===========================================================================

# AI coaching layer (Phase 4). Disabled unless explicitly enabled AND a key set.
# AI_COACHING_ENABLED="false"
# ANTHROPIC_API_KEY=""
